{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/apps/auth/login",
      "destination": "/api/apps/auth/login-handler"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/backend/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/api/site/:path*"
    }
  ],
  "functions": {
    "api/site/[...path].js": {
      "maxDuration": 60
    },
    "api/backend/[...path].js": {
      "maxDuration": 60
    },
    "api/apps/auth/login.js": {
      "maxDuration": 30
    }
  }
}
