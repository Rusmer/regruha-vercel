{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/proxy.js": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/((?!api/proxy).*)",
      "dest": "/api/proxy",
      "transforms": [
        {
          "type": "request.path",
          "op": "set",
          "args": "/$1"
        },
        {
          "type": "request.headers",
          "op": "set",
          "target": {
            "key": "x-regruha-original-path"
          },
          "args": "/$1"
        }
      ]
    }
  ]
}
